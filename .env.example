# =========================================================================
# 운영서버 배포용 환경변수 템플릿
#
# 사용법: 운영서버의 배포 디렉터리(예: /opt/stylehub)에 이 파일을
#         `.env` 로 복사한 뒤 실제 값을 채운다. .env 는 절대 커밋하지 않는다.
#         docker compose 가 같은 디렉터리의 .env 를 자동으로 읽어 주입한다.

# --- 배포할 이미지 태그 (Jenkins 가 BUILD_NUMBER 로 덮어씀) ---------------
IMAGE_TAG=latest

# --- MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=stylehub
DB_USERNAME=root
DB_PASSWORD=root
# mysql 컨테이너 root 비밀번호 (초기화용)
MYSQL_ROOT_PASSWORD=root
JPA_DDL_AUTO=validate

# --- Redis
REDIS_HOST=redis
REDIS_PORT=6379

# --- Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/users/oauth/google/callback

# --- Toss Payments
# 토스페이먼츠 개발자센터(https://developers.tosspayments.com)에서 발급받은 시크릿 키
TOSS_SECRET_KEY=your-toss-secret-key

# --- JVM (선택)
# 컨테이너 mem_limit 대비 힙 비율. 미설정 시 Dockerfile 기본값 사용
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC
