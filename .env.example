# =========================================================================
# 환경 변수 템플릿
#
# [운영] 구역 — systemd EnvironmentFile 기준
#   운영서버 배포 디렉터리(/home/ubuntu/stylehub)에 이 파일을 `.env` 로 복사해 실제 값을 채운다.
#   stylehub.service 유닛이 EnvironmentFile= 로 읽어 java 프로세스의 환경 변수로 넣는다.
#   운영은 Docker 를 쓰지 않으므로 docker compose 를 거치지 않는다.
#   (유닛 파일은 저장소에 없다. 경로는 Jenkinsfile 의 "운영서버 사전 준비" 항목 기준이다.)
#   application-prod.properties 가 ${...} 로 읽는 변수를 모두 적었고, 값은 전부 예시 자리표시자다.
#   ProdProfilePropertiesTest 가 운영 프로파일의 변수가 이 파일에 빠짐없이 있는지 검사한다.
#   기본값이 없는 변수(DB_PASSWORD, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOSS_SECRET_KEY)가 빠지면
#   앱이 기동하지 않는다. 시크릿 없이 운영에 뜨는 것을 막으려는 의도다.
#
# [로컬] 구역 — docker compose 기준
#   docker-compose.yml(로컬 MySQL·Redis)과 application-local.properties 가 읽는 LOCAL_* 변수다.
#   모두 선택이라 주석으로 두었고, 운영 .env 에는 넣지 않는다.
#
# 공통 주의
#   - .env 는 .gitignore 대상이다. 실제 값이 든 파일은 절대 커밋하지 않는다.
#   - systemd EnvironmentFile 은 KEY=VALUE 한 줄 형식이며 export 와 ${} 치환을 지원하지 않는다.
#     주석은 줄 맨 앞에 # 로만 쓰고, 값 뒤에 붙이지 않는다.
# =========================================================================


# ---------------------------------------------------------------- [운영] ---

# --- 프로파일
# 운영 설정(application-prod.properties)을 켠다. 유닛의 ExecStart 에서 --spring.profiles.active=prod 로
# 이미 지정했다면 없어도 되지만, 저장소에서 유닛 파일을 확인할 수 없어 여기 명시한다.
SPRING_PROFILES_ACTIVE=prod

# --- MySQL (서버에 네이티브 설치 — 같은 서버면 localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stylehub
DB_USERNAME=stylehub
DB_PASSWORD=change-me
# 운영 기본은 스키마 검증만 한다. 최초 배포처럼 앱이 스키마를 만들어야 할 때만 한시적으로 update 로 올린다.
JPA_DDL_AUTO=validate

# --- Redis (서버에 네이티브 설치 — 같은 서버면 localhost)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# 구글 콘솔에 등록한 승인된 리디렉션 URI 와 글자 하나까지 같아야 한다.
GOOGLE_REDIRECT_URI=http://your-host.example:8080/api/v1/users/oauth/google/callback

# --- Toss Payments
# 토스페이먼츠 개발자센터(https://developers.tosspayments.com)에서 발급받은 시크릿 키
TOSS_SECRET_KEY=your-toss-secret-key

# --- 세션 쿠키
# HTTPS 로 서비스할 때만 true. HTTP 접속에서 true 면 브라우저가 세션 쿠키를 보내지 않아 로그인이 유지되지 않는다.
SESSION_COOKIE_SECURE=false

# --- JVM (선택)
# 유닛의 ExecStart 가 $JAVA_OPTS 를 참조하도록 작성되어 있을 때만 효과가 있다(Spring 이 읽는 변수가 아니다).
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC


# ---------------------------------------------------------------- [로컬] ---
# 로컬 개발용 docker compose 변수. 비워 두면 괄호 안 기본값을 쓴다.
# 셸에서 export 하면 docker compose 와 bootRun(application-local.properties)에 함께 적용된다.
# 로컬 .env 에 적으면 docker compose 만 읽으므로, 그때는 bootRun 에도 같은 값을 export 한다.

# 로컬에 이미 MySQL(3306)·Redis(6379)가 떠 있어 포트가 겹칠 때 바꾼다. (기본 3306 / 6379)
# LOCAL_MYSQL_PORT=13306
# LOCAL_REDIS_PORT=16379

# 로컬 MySQL 계정 비밀번호. 볼륨이 비어 있는 첫 기동 때만 적용된다. (기본 stylehub / root)
# LOCAL_MYSQL_PASSWORD=stylehub
# LOCAL_MYSQL_ROOT_PASSWORD=root
