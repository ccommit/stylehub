# =========================================================================
# 운영서버 배포용 환경변수 템플릿
#
# 사용법: 운영서버의 배포 디렉터리(/home/ubuntu/stylehub)에 이 파일을 `.env` 로
#         복사한 뒤 실제 값을 채운다. .env 는 절대 커밋하지 않는다.
#         systemd 유닛(stylehub.service)이 EnvironmentFile= 로 이 파일을 읽어
#         프로세스 환경변수로 주입한다 (docker compose를 거치지 않음 — 운영은
#         네이티브 배포 방식이라 이 값들은 java 프로세스에 직접 주입된다).
#
# MySQL/Redis도 이 서버에 네이티브로 설치되어 있으므로 기본값은 localhost 기준이다.

# --- MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stylehub
DB_USERNAME=stylehub
DB_PASSWORD=change-me
JPA_DDL_AUTO=validate

# --- Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/users/oauth/google/callback

# --- Toss Payments
# 토스페이먼츠 개발자센터(https://developers.tosspayments.com)에서 발급받은 시크릿 키
TOSS_SECRET_KEY=your-toss-secret-key

# --- JVM (선택)
# systemd 유닛의 ExecStart가 $JAVA_OPTS를 참조하도록 구성돼 있다면 여기서 조정.
# EC2 인스턴스 전체 메모리 대비 힙 비율 기준 (예: t3.micro 1GB → 75% 근방 권장)
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC
